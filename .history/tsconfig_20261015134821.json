{
  "compilerOptions": {
    "module": "esnext",
    "lib": [
      "es5",
      "dom",
      "esnext"
    ], // Next.js için önerilen lib'ler
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "baseUrl": ".",
    "paths": {
      "crc-32": [
        "."
      ],
      "@/*": [
        "./*"
      ],
      "@/lib/*": [
        "./lib/*"
      ]
    },
    "types": ["node"],
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2017",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "src-tauri"
  ]
}
