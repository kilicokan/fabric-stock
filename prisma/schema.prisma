generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Product
model Product {
  id             Int      @id @default(autoincrement())
  modelNo        String   @unique
  name           String
  materialTypeId Int?
  fabricId       Int?
  groupId        Int?
  taxRateId      Int?
  description    String?
  image          String?
  createdAt      DateTime @default(now())

  fabric       Fabric?       @relation(fields: [fabricId], references: [id])
  group        Group?        @relation(fields: [groupId], references: [id])
  materialType MaterialType? @relation(fields: [materialTypeId], references: [id])
  taxRate      TaxRate?      @relation(fields: [taxRateId], references: [id])
}

// 2. MaterialType
model MaterialType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// 3. Group
model Group {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// 4. TaxRate
model TaxRate {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// 5. FabricType (sadece isim, başka ilişki yok)
model FabricType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

// 6. Color
model Color {
  id          Int           @id @default(autoincrement())
  code        String?       @unique
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  entries     FabricEntry[]
}

// 7. CuttingTable
model CuttingTable {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  createdAt DateTime     @default(now())
  exits     FabricExit[]
}

// 8. FabricEntry (kumaş girişi)
model FabricEntry {
  id          Int      @id @default(autoincrement())
  fabricId    Int
  colorId     Int
  quantityKg  Float
  lengthMeter Float?
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  color       Color        @relation(fields: [colorId], references: [id])
  fabric      Fabric       @relation(fields: [fabricId], references: [id])
  fabricExits FabricExit[] @relation("FabricEntryToFabricExit")

  @@map("fabric_entries")
}

// 9. FabricExit (kumaş çıkışı)
model FabricExit {
  id                 Int      @id @default(autoincrement())
  modelNo            String
  modelName          String?
  orderNo            String
  customerId         String
  layerCount         Int      @default(1)
  productWeightKg    Float    @default(0)
  productLengthMeter Float    @default(0)
  grammage           Float    @default(0)
  externalProductId  String?
  unitType           String
  fabricType         String?
  color              String?
  cuttingTableId     Int
  reportNumber       String?
  plannedLayers      String? // JSON string for customer-based planned layers
  actualLayers       String? // JSON string for customer-based actual layers
  createdAt          DateTime @default(now())
  fabricEntryId      Int?

  // İLİŞKİLER
  cuttingTable CuttingTable @relation(fields: [cuttingTableId], references: [id])
  fabricEntry  FabricEntry? @relation("FabricEntryToFabricExit", fields: [fabricEntryId], references: [id])

  @@map("fabric_exits")
}

// 10. User
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         Role     @default(OPERATOR)
  name         String?
  phone        String?
  stockAccess  Boolean  @default(false)
  fasonAccess  Boolean  @default(false)
  mobileAccess Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fasonTrackings     FasonTracking[]
  assignedWorkOrders WorkOrder[]
  sentMessages       Message[] @relation("MessageSent")
  receivedMessages   Message[] @relation("MessageReceived")
}

// 11. Customer
model Customer {
  id        Int             @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  balance   Float           @default(0)
  createdAt DateTime        @default(now())
  orders    CustomerOrder[]
}

// 12. CustomerOrder
model CustomerOrder {
  id         Int                 @id @default(autoincrement())
  orderNo    String // no
  customerId Int
  customer   Customer            @relation(fields: [customerId], references: [id])
  items      CustomerOrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

// 13. CustomerOrderItem
model CustomerOrderItem {
  id           Int           @id @default(autoincrement())
  orderId      Int
  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productCode  String // kod
  color        String // varyant
  description  String? // açıklama
  notes        String? // not
  quantity     Float // miktar
  unit         String? // birim
  deliveryDate DateTime? // teslim zamanı
  unitPrice    Float // birim fiyat
  totalPrice   Float // toplam fiyat
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// 12. Supplier
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
}

// 13. Fabric (kumaş tanımı)
model Fabric {
  id            Int      @id @default(autoincrement())
  code          String?  @unique
  name          String
  property      String?
  width         Float?
  length        Float?
  depot         String?
  unit          String?
  stockQuantity Float    @default(0)
  createdAt     DateTime @default(now())

  entries  FabricEntry[]
  products Product[]
}

// 14. FabricDocument (kumaş irsaliye/fatura)
model FabricDocument {
  id        Int      @id @default(autoincrement())
  type      String // İrsaliye, Fatura
  number    String   @unique
  date      DateTime
  customer  String
  warehouse String
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler eklenebilir: customerId, warehouseId vs.
}

// 14. FasonWorkshop
model FasonWorkshop {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  contactPerson  String?
  phone          String?
  address        String?
  specialization WorkshopType
  isActive       Boolean      @default(true)
  balance        Float        @default(0)
  totalEarnings  Float        @default(0)
  totalPayments  Float        @default(0)
  maxCapacity    Float        @default(500000) // Atölyenin maksimum kapasite tutarı (₺)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  fasonTrackings FasonTracking[]
}

// 15. WorkOrder
model WorkOrder {
  id                   Int         @id @default(autoincrement())
  orderNo              String      @unique
  productCode          String
  productName          String?
  quantity             Int
  customerName         String?
  deliveryDate         DateTime?
  notes                String?
  status               OrderStatus @default(BEKLIYOR)
  priority             Priority    @default(MEDIUM)
  assignedToMobile     Boolean     @default(false)
  mobileAssignmentDate DateTime?   @map("mobile_assignment_date")
  assignedUserId       Int?
  externalErpId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedUser   User?           @relation(fields: [assignedUserId], references: [id])
  fasonTrackings FasonTracking[]
}

// 16. FasonTracking
model FasonTracking {
  id               Int           @id @default(autoincrement())
  workOrderId      Int
  workshopId       Int?
  userId           Int
  processType      ProcessType
  status           ProcessStatus
  assignedQuantity Int?
  unitPrice        Float?
  totalPrice       Float?
  startDate        DateTime?
  endDate          DateTime?
  pickupDate       DateTime?
  deliveryDate     DateTime?
  notes            String?
  problemNotes     String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id])
  workshop  FasonWorkshop? @relation(fields: [workshopId], references: [id])
}

// 17. Message (Web-Mobile Messaging)
model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int
  recipientId Int
  content     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("MessageSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// ======================
// ENUMS
// ======================

enum Role {
  ADMIN
  OPERATOR
  STOCK_MANAGER
  FASON_TRACKER
}

enum WorkshopType {
  DIKIM
  BASKI_NAKIS
  UTU
}

enum OrderStatus {
  BEKLIYOR
  ALINDI
  ATÖLYEDE
  HAZIR
  TESLIM_EDILDI
  SORUN_VAR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProcessType {
  KESIM
  DIKIM
  BASKI_NAKIS
  UTU
}

enum ProcessStatus {
  BEKLIYOR
  ALINDI
  ATÖLYEDE
  HAZIR
  TESLIM_EDILDI
  SORUN_VAR
  IPTAL_EDILDI
}
